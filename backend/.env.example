# Copy values into IntelliJ Run Configuration environment variables.
# Do not commit real credentials or a production signing key.
ORACLE_JDBC_URL=jdbc:oracle:thin:@//<rds-endpoint>:1521/<service-name>
ORACLE_USERNAME=<oracle-schema-user>
ORACLE_PASSWORD=<load-from-a-secret-store>
JWT_ISSUER=meal-savings-api
JWT_SECRET_BASE64=<output-of-openssl-rand-base64-32>
JWT_ACCESS_TOKEN_TTL=PT30M
CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080
