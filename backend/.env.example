# Copy values into IntelliJ Run Configuration environment variables.
# Do not commit real credentials or a production signing key.
DB_JDBC_URL=jdbc:postgresql://<rds-endpoint>:5432/<database>?sslmode=verify-full&sslrootcert=<absolute-path-to-rds-ca.pem>
DB_USERNAME=<database-user>
DB_PASSWORD=<load-from-a-secret-store>
JWT_ISSUER=meal-savings-api
JWT_SECRET_BASE64=<output-of-openssl-rand-base64-32>
JWT_ACCESS_TOKEN_TTL=PT30M
CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080
